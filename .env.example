[TEMPLATE]
# ClaudeBridge 配置模板。复制为 .env 后按需修改；真实环境变量优先于本文件。
# 本文件是「配置契约」：doc/design.md 第 8 节的每一项都应能在这里与
# claude_web/config.py 中找到。tests/test_config_drift.py 会核对三者一致性。

# ---- 服务监听 ----
# 默认只监听本机回环地址。改成 0.0.0.0 会让任何能访问该地址的人
# 复用你的 Claude 网页登录态与额度（启动会打醒目告警，且不受支持）。
# 需要远程访问请使用 SSH 端口转发 / VPN 等外部手段。
HOST=127.0.0.1
PORT=8003

# ---- 目标站点 ----
# Claude 官方网页入口。页面改版时可通过它切换到兼容镜像或语言版本。
CLAUDE_WEBSITE=https://claude.ai/new
# 允许 /session/link 绑定的站点主机（逗号或 "||" 分隔，子域自动允许，"*" = 不限制）。
LINK_ALLOWED_HOSTS=claude.ai
# 缺省初始会话链接：设置后默认会话桶直接进入这条会话（仅默认桶，避免多桶串线）。
# 留空 = 默认桶也每次新开对话；非法值会被忽略并回落到新开对话。
CLAUDE_DEFAULT_LINK_URL=

# ---- 路径 ----
USER_DATA_DIR=./user_data
OUTPUT_DIR=./output
SESSION_FILE=./user_data/.claude_state
TASK_FILE_DIR=./user_data/.claude_tasks

# ---- 运行模式 / 调试 ----
# 实测有头模式最稳；无显示服务器请用 `xvfb-run -a python claude_api_server.py`，
# 而不是直接设 HEADLESS=true（无头模式可能命中站点挑战页，属未验证能力）。
HEADLESS=false
# 启用 Chromium 渲染进程沙箱（去掉 Playwright 默认的 --no-sandbox 与顶部提示）。
BROWSER_SANDBOX=true
# 浏览器通道：留空 = Playwright 自带 Chromium；"chrome" / "msedge" = 本机真实浏览器。
BROWSER_CHANNEL=
# 启动方式：playwright = Playwright 启动；chrome-cdp = 启动本机普通 Chrome 并经 CDP 连接。
# CDP 模式仍可能遇到 Cloudflare 校验；需要时请在打开的窗口中人工完成。
BROWSER_LAUNCH_MODE=playwright
# CDP 仅绑定 127.0.0.1，勿将调试端口暴露给网络中的其他设备。
BROWSER_CDP_PORT=9222
# Chrome/Chromium 用户目录内的子 profile（如 Default / Profile 1）；留空 = 默认 profile。
# 只在 USER_DATA_DIR 指向「带登录态的 profile 副本」时才有意义。
BROWSER_PROFILE_DIRECTORY=
# 使用操作系统钥匙串（macOS Keychain）而不是 mock keychain。
# 复用已有 Chrome profile 时需开启，否则 cookie 无法解密、会话会被判无效。
BROWSER_USE_OS_KEYCHAIN=false
CLAUDE_DEBUG=false
# 是否允许保存调试工件（截图 / DOM 片段）。默认关闭；开启后仍会脱敏。
SAVE_DEBUG_ARTIFACTS=false
# 是否注册 /debug/dom 诊断路由（仅调试模式 + 显式开启时开放）。
ENABLE_DEBUG_DOM=false

# ---- 鉴权（可选）----
# 设置后保护生成类 API 与管理端点，需带 `Authorization: Bearer <token>`。
# 留空 = 不校验（仅适合本机使用）。
BRIDGE_TOKEN=
# /session/reset 的额外令牌保护；留空 = 不校验。
RESET_TOKEN=

# ---- 浏览器 ----
# 导航 / 输入 / DOM 操作的默认超时（秒）。
CLAUDE_BROWSER_TIMEOUT=30
# 新建/恢复页面后等待输入区就绪的超时（毫秒）。
READY_TIMEOUT_MS=15000
# 单次填充输入框的超时（毫秒）与重试次数（每次重新定位）。
FILL_TIMEOUT_MS=10000
FILL_RETRIES=3
# 页面池保留的会话页面上限；超出按 LRU 回收（不丢会话元数据）。
MAX_PAGE_POOL=4

# ---- 回复生成 / 结束检测 ----
# 单轮绝对超时（秒）。
CLAUDE_TIMEOUT=300
# 到达绝对超时但页面仍在生成时的额外延长额度（秒）；0 = 不延长。
RESPONSE_TIMEOUT_EXTEND_S=300
# 明确可安全重试的最大次数（默认保守）。
CLAUDE_RETRIES=1
RETRY_BACKOFF_S=1.0
# 检查 DOM 更新的间隔（秒）。
POLL_INTERVAL_S=1.5
# 判定内容稳定所需的连续轮询次数。
STABLE_POLLS=4
# 连续无有效进展时判定停滞的次数（快速失败，不再干等到绝对超时）。
STALL_POLLS=20
# 结束判定前要求内容完全静默的轮询次数（区分「真的结束」与「分段输出间的停顿」）。
QUIET_POLLS=4

# ---- 会话 ----
# 是否启用桶级隔离；关闭后所有请求共用默认桶。
SESSION_SCOPING=true
SESSION_KEY_HEADER=X-Claude-Session
# 请求头与 user 字段都缺失时，是否按客户端 User-Agent 自动分桶。
SESSION_SCOPING_BY_UA=true
# 桶键长度上限。
SESSION_KEY_MAX_LEN=64
# 同时在用的会话桶数量上限（超额按 LRU 回收页面，不回收在途任务）。
MAX_SESSION_BUCKETS=4
# 同桶等待锁的超时（秒）：超时返回可重试的忙碌错误（HTTP 503）。
BUCKET_LOCK_TIMEOUT_S=120
# 空闲页面回收时间（秒）；0 = 不按空闲回收。
BUCKET_IDLE_TTL_S=900
# 启动时忽略已保存会话、强制新开对话（搭配完整历史播种才安全）。
CLAUDE_NEW_SESSION=false
# 单条 tool 结果注入 prompt 的最大字符数；0 = 不限制。
TOOL_RESULT_MAX_CHARS=20000

# ---- 上下文预算 ----
# 桥接层独立的字符预算；超出时优先保留当前任务与最新轮次，并在诊断中标注裁剪。
CLAUDE_MAX_CONTEXT_CHARS=100000
# 单条 system/developer 消息注入时的最大字符数；0 = 不限制。
SYSTEM_MAX_CHARS=8000
# 播种 prompt 里的「环境说明」：告诉模型本机就是工作目录，不必向用户索要地址 /
# 让用户手动执行。留空 = 不注入。
SEED_ENV_NOTE=[环境说明] 项目就在本机的当前工作目录里，你可以直接下命令（如 git status / git add / git commit / git log / ls / cat）来完成查看与修改，无需向用户索要仓库地址，也无需用户手动执行。
# 工具说明里是否输出每个工具的完整 JSON Schema（false = 紧凑的 name(必填参数) 形态）。
TOOLS_INSTRUCTION_VERBOSE=false
# 工具说明里单条描述的最大字符数；0 = 不限制。
TOOLS_DESC_MAX_CHARS=200

# ---- API ----
# 是否注册 /v1/responses（Responses API 兼容子集）。默认关闭，验证通过后再开。
ENABLE_RESPONSES_API=false
# 流式生成期间的 SSE keep-alive 注释间隔（秒）；0 = 关闭。
STREAM_KEEPALIVE_S=10.0
# 工具模式是否整段缓冲后再返回（避免泄漏内部工具标记）。
TOOL_CALL_BUFFER=true
# 工具调用必须以此标记包裹，解析器只认该载体。
TOOL_CALL_FENCE=tool_call

# ---- 任务快照 ----
TASK_SNAPSHOT_ENABLED=true
TASK_GOAL_MAX_CHARS=2000
TASK_KEEP_MESSAGES=8

# ---- DOM 选择器（真实页面探测后确认；此处为可回退的候选）----
INPUT_SELECTORS=div[contenteditable="true"][role="textbox"]||div.ProseMirror[contenteditable="true"]||div[contenteditable="true"]||textarea
SEND_BUTTON_SELECTORS=button[aria-label*="Send"]||button[data-testid*="send"]||button[type="submit"]
RESPONSE_SELECTORS=div[data-testid="assistant-message"]||[data-message-author-role="assistant"]||div.font-claude-message||div[class*="font-claude-message"]
GENERATING_SELECTORS=button[aria-label*="Stop"]||button[data-testid*="stop"]||[data-is-streaming="true"]
NEW_CHAT_SELECTORS=a[href="/new"]||button[aria-label*="New chat"]||a[aria-label*="New chat"]
AUTH_INDICATORS=input[type="password"]||a[href*="/login"]||button[data-testid*="login"]
CHALLENGE_INDICATORS=iframe[title*="challenge"]||div[class*="cf-challenge"]
# 站点安全校验页的文案特征（"||" 分隔，同时匹配标题与可见文本）。
# 仅用于识别并如实上报 challenge_required；不自动勾选/绕过任何验证。
CHALLENGE_TEXT_PATTERNS=performing security verification||security verification||verify you are human||checking your browser||just a moment||attention required
CONTEXT_LIMIT_PATTERNS=context limit||conversation is too long||maximum length||对话长度上限||已达长度限制

# ---- 模型别名 ----
# 逻辑模型别名（逗号分隔，alias=网页UI标签）。默认只公开 claude-web；
# 未经验证的网页模型标签不默认公开（doc/design.md 14）。
MODEL_ALIASES=

# ---- 日志 ----
LOG_LEVEL=INFO
# 内存缓存的会话状态条数上限（超出按 LRU 逐出；状态已落盘，逐出安全）。
MAX_SESSION_STATE_CACHE=64
